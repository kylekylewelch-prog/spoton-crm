# ---------------------------------------------------------------------------
# SpotOn CRM configuration
# ---------------------------------------------------------------------------

# Database.
#   Leave unset (or use a pglite:// URL) to run against the embedded PGlite
#   database — real Postgres compiled to WASM, no server required. Ideal for
#   local development, CI and the test suite.
#   Set a postgres:// URL to run against a real Postgres server (Neon,
#   Supabase, RDS, docker-compose, ...).
# DATABASE_URL=postgres://spoton:spoton@localhost:5432/spoton
DATABASE_URL=pglite://./.pglite

# Secret used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=dev-only-insecure-secret-change-me

# Bearer token required by the MCP HTTP transport at /api/mcp.
MCP_API_TOKEN=dev-mcp-token

# Seeded demo password for every seeded user (login with e.g. ae@spoton.dev).
SEED_PASSWORD=spoton

# Outbound integration adapters. When unset the mock adapters are used, which
# record every call in the integration event log so flows stay fully testable.
# SLACK_WEBHOOK_URL=
# STRIPE_API_KEY=
# DOCUSIGN_API_KEY=
